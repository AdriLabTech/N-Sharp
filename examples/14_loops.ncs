fn main() -> nothing {
    loop (i $int = 0; i < 3; i++) {
        print("{i} ");
    }
    println();
    loop (j := 0; j < 3; j++) {
        print("{j} ");
    }
    println();
    let k = 0;
    loop (; k < 3; k++) {
        print("{k} ");
    }
    println();
    let n = 0;
    loop (;;) {
        n++;
        if n == 4 {
            break;
        }
    }
    println(n);
    let w = 10;
    while w > 7 {
        w -= 1;
    }
    println(w);
    let total = 0;
    loop (c : "abc") {
        total += c as $int;
    }
    println(total);
}
