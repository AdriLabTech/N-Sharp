enum Token {
    Num($float),
    Plus,
    Minus,
    Star,
    Slash,
    LParen,
    RParen
}

struct Lexer {
    chars List<$char>;
    pos $int;
}

impl Lexer {
    fn new(src $string) -> Lexer {
        return Lexer { chars: src.chars(), pos: 0 };
    }

    fn tokens() -> Result<List<Token>, $string> {
        let out List<Token>;
        while self.pos < self.chars.length() {
            c := self.chars[self.pos];
            if c.is_whitespace() {
                self.pos += 1;
            } else if c.is_digit() {
                start := self.pos;
                while self.pos < self.chars.length() && (self.chars[self.pos].is_digit() || self.chars[self.pos] == '.') {
                    self.pos += 1;
                }
                text := "";
                loop (i := start; i < self.pos; i++) {
                    text += self.chars[i];
                }
                n := text.parse_float()?;
                out.add(Token.Num(n));
            } else {
                t := match c {
                    '+' => Token.Plus;
                    '-' => Token.Minus;
                    '*' => Token.Star;
                    '/' => Token.Slash;
                    '(' => Token.LParen;
                    ')' => Token.RParen;
                    _ => return Error("carácter inesperado '{c}'");
                };
                out.add(t);
                self.pos += 1;
            }
        }
        return Ok(out);
    }
}

struct Parser {
    toks List<Token>;
    i $int;
}

impl Parser {
    fn peek() -> Token? {
        return self.toks.get(self.i);
    }

    fn expr() -> Result<$float, $string> {
        left := self.term()?;
        loop (;;) {
            match self.peek() {
                Some(Token.Plus) => {
                    self.i += 1;
                    left += self.term()?;
                }
                Some(Token.Minus) => {
                    self.i += 1;
                    left -= self.term()?;
                }
                _ => break;
            }
        }
        return Ok(left);
    }

    fn term() -> Result<$float, $string> {
        left := self.factor()?;
        loop (;;) {
            match self.peek() {
                Some(Token.Star) => {
                    self.i += 1;
                    left *= self.factor()?;
                }
                Some(Token.Slash) => {
                    self.i += 1;
                    d := self.factor()?;
                    if d == 0.0 { return Error("división por cero"); }
                    left /= d;
                }
                _ => break;
            }
        }
        return Ok(left);
    }

    fn factor() -> Result<$float, $string> {
        return match self.peek() {
            Some(Token.Num(n)) => {
                self.i += 1;
                Ok(n)
            }
            Some(Token.Minus) => {
                self.i += 1;
                v := self.factor()?;
                Ok(-v)
            }
            Some(Token.LParen) => {
                self.i += 1;
                v := self.expr()?;
                match self.peek() {
                    Some(Token.RParen) => {
                        self.i += 1;
                        Ok(v)
                    }
                    _ => Error("falta )")
                }
            }
            _ => Error("expresión inválida")
        };
    }
}

fn eval(src $string) -> Result<$float, $string> {
    toks := Lexer.new(src).tokens()?;
    p := Parser { toks: toks, i: 0 };
    v := p.expr()?;
    if p.i < toks.length() { return Error("sobran tokens"); }
    return Ok(v);
}

fn main() -> nothing {
    exprs := ["1 + 2 * 3", "(1 + 2) * 3", "10 / 4 - 1", "-(2 + 3) * 2", "1 / 0", "2 +", "3 $ 4", "((2))"];
    loop (e : exprs) {
        match eval(e) {
            Ok(v) => println("{e} = {v}");
            Error(m) => println("{e} -> error: {m}");
        }
    }
}
